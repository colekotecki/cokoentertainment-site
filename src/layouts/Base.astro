---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { STUDIO } from "../site";
import SocialLinks from "../components/SocialLinks.astro";
import "../styles/global.css";

// The studio logo: drop a file named logo.png (or .webp/.jpg) into src/assets/brand/
// and it replaces the star mark in the header on every page.
const brandFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/brand/logo.{png,webp,jpg,jpeg}", { eager: true });
const brandLogo = Object.values(brandFiles)[0]?.default;

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = STUDIO.tagline, image } = Astro.props;
const fullTitle = title ? `${title} · ${STUDIO.name}` : STUDIO.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: "/games/harness-the-elements/", label: "Games" },
  { href: "/news/", label: "News" },
  { href: "/press/", label: "Press" },
  { href: "/merch/", label: "Merch" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title={`${STUDIO.name} News`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/">
          {brandLogo ? (
            <Image src={brandLogo} alt="" class="brand-logo" height={44} densities={[1, 2]} loading="eager" />
          ) : (
            <span class="brand-mark" aria-hidden="true">✦</span>
          )}
          {STUDIO.name}
        </a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <SocialLinks />
      </div>
      <div class="wrap footer-row footer-legal">
        <p>© {new Date().getFullYear()} {STUDIO.legalName}</p>
        <p>
          <a href={`mailto:${STUDIO.email}`}>{STUDIO.email}</a>
          <span aria-hidden="true"> · </span>
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>
