---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"news">[];
}

const { posts } = Astro.props;
const fmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" });
---

<ul class="news-list">
  {posts.map((post) => (
    <li class="news-item panel">
      <a href={`/news/${post.id}/`}>
        <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        <h3>{post.data.title}</h3>
        <p>{post.data.summary}</p>
      </a>
    </li>
  ))}
</ul>
