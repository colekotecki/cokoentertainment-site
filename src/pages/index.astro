---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SteamButton from "../components/SteamButton.astro";
import NewsList from "../components/NewsList.astro";
import { GAME, STUDIO } from "../site";
import { getNews } from "../lib/news";
import hero from "../assets/hero.png";
import logo from "../assets/logo.png";

const latest = (await getNews()).slice(0, 3);
---

<Base description={`${STUDIO.name} is an independent game studio. Our first game is ${GAME.title}.`}>
  <section class="hero">
    <Image src={hero} alt="" class="hero-bg" widths={[960, 1920]} sizes="100vw" loading="eager" />
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <Image src={logo} alt={GAME.title} class="hero-logo" widths={[420, 840]} sizes="(max-width: 600px) 80vw, 420px" loading="eager" />
      <p class="hero-pitch">{GAME.pitch}</p>
      <div class="button-row">
        <SteamButton />
        <a class="button" href={`/games/${GAME.slug}/`}>About the game</a>
      </div>
    </div>
  </section>
  <div class="element-strip" aria-hidden="true">
    <span style="background: var(--earth)"></span>
    <span style="background: var(--air)"></span>
    <span style="background: var(--energy)"></span>
    <span style="background: var(--grass)"></span>
    <span style="background: var(--water)"></span>
  </div>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Latest news</p>
      <h2>From the workshop</h2>
      <NewsList posts={latest} />
      <p><a href="/news/">All news →</a></p>
    </div>
  </section>

  <section class="section tinted">
    <div class="wrap about">
      <p class="eyebrow">The studio</p>
      <h2>About {STUDIO.name}</h2>
      <div class="prose">
        <p class="lede">
          {STUDIO.name} uses AI tools to turn a passion for game design into finished games. AI lets us
          build worlds and ideas that would otherwise stay on the drawing board. Every game is thoroughly
          playtested so it plays well and respects your time, and we will never release a game we wouldn't
          happily play ourselves.
        </p>
        <p>
          {STUDIO.name} is a one-person studio, run alongside a full-time job and a family of four children.
          Without AI, these games could not exist. Player feedback is always welcome: if anything feels rough
          or unpolished, please get in touch, and I will work to polish that aspect.
        </p>
        <p>
          Questions, feedback, press or just saying hi: <a href={`mailto:${STUDIO.email}`}>{STUDIO.email}</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(82vh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(243, 234, 215, 0.55) 0%, rgba(243, 234, 215, 0.15) 60%, rgba(74, 59, 46, 0.15) 100%);
  }
  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .hero-logo {
    width: min(420px, 80vw);
    filter: drop-shadow(0 6px 12px rgba(74, 59, 46, 0.35));
  }
  .hero-pitch {
    max-width: 36rem;
    font-size: 1.3rem;
    background: rgba(243, 234, 215, 0.9);
    border: 2px solid var(--vine);
    border-radius: var(--radius);
    padding: 0.9rem 1.2rem;
    margin: 1.5rem 0 0;
  }
  .hero .button-row { justify-content: center; }
</style>
